-- tools/bridge/test.luau  -  checks the bridge's pure helpers with the Luau CLI (not run in Studio):
--   luau tools/bridge/test.luau
-- Fixed cases only; the per-file checks against real files are generated by tools/bridge/test_files.py.
local Pure = require("./GenesisBridge.server")
local failures = 0
local function check(name, got, want)
	if got ~= want then
		failures += 1
		print("FAIL " .. name .. ": got " .. tostring(got) .. ", want " .. tostring(want))
	end
end

check("pascal 1", Pure.pascal("central_command"), "CentralCommand")
check("pascal 2", Pure.pascal("outpost07"), "Outpost07")
check("pascal 3", Pure.pascal("memory_set"), "MemorySet")
check("pascal 4", Pure.pascal("BuildKit"), "BuildKit")
check("b64 0", Pure.base64(""), "")
check("b64 1", Pure.base64("f"), "Zg==")
check("b64 2", Pure.base64("fo"), "Zm8=")
check("b64 3", Pure.base64("foo"), "Zm9v")
check("b64 4", Pure.base64("foobar"), "Zm9vYmFy")
check("job 1", Pure.jobId("-- job: 0001-hello\nreturn 1"), "0001-hello")
check("job 2", Pure.jobId("  --job:abc.2_x\n"), "abc.2_x")
check("job 3", Pure.jobId("return 1 -- job: x"), nil)
local sumA, sumB = Pure.sum("a\r\nb")
local sumC, sumD = Pure.sum("a\nb")
check("crlf bytes", sumA, sumC)
check("crlf sum", sumB, sumD)
local safe = Pure.jsonSafe({ 1, 2, { x = 0 / 0 }, [10] = "gap" })
check("mixed table keys", type(safe["10"]), "string")
check("nan", Pure.jsonSafe({ x = 0 / 0 }).x, "nan")
print(failures == 0 and "PURE OK" or ("PURE FAILURES " .. failures))
